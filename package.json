{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:slack": "pnpm --filter channel dev",
    "channel:status": "pnpm dlx copilotkit@latest channels status --json",
    "channel:setup": "pnpm dlx copilotkit@latest channels setup",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:web": "pnpm --filter web dev",
    "test": "pnpm -r --if-present run test",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
